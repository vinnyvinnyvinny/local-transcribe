# Copy this file to .env and fill in your values.
# All values are optional — uncomment and set only what you need.

# ── Speaker diarisation ───────────────────────────────────────────────────────
# Required for the "Speaker" toggle in the browser UI and ?diarize=true API param.
# Get a free token at https://huggingface.co/settings/tokens
# Accept terms at: https://huggingface.co/pyannote/speaker-diarization-3.1
#                  https://huggingface.co/pyannote/segmentation-3.0
HF_TOKEN=

# ── Model ─────────────────────────────────────────────────────────────────────
# Default Whisper model. Options: whisper-tiny, whisper-base, whisper-small,
#                                  whisper-medium (default), whisper-large-v3
#WHISPER_MODEL=whisper-medium

# ── Language ──────────────────────────────────────────────────────────────────
# Force a transcription language instead of auto-detecting.
# Use ISO 639-1 codes (e.g. en, fr, de, es, pt). Default: auto
#LANGUAGE=auto

# ── Model memory ──────────────────────────────────────────────────────────────
# How long (seconds) to keep the model loaded between requests.
#   0  = unload immediately after each request (default — lowest memory use)
#   N  = keep loaded for N seconds of inactivity, then unload
#  -1  = never unload (fastest response time, highest memory use)
#MODEL_TTL=0

# ── Network ───────────────────────────────────────────────────────────────────
# Host port is set in docker-compose.yml (default: 9876 → container 8080).
# Change the internal container port here only if you have a conflict.
#PORT=8080

# ── Storage ───────────────────────────────────────────────────────────────────
# Where Whisper model files are stored inside the container.
# Maps to the transcribe-models Docker volume — change only if you mount elsewhere.
#WHISPER_CACHE_DIR=/data/whisper-models
